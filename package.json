{
	"name": "courtlistener",
	"version": "0.1.0",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"check": "tsc --noEmit",
		"watch": "esbuild --format=cjs src/main.ts --watch=forever --bundle --outdir=. --external:obsidian",
		"build": "esbuild --format=cjs src/main.ts --bundle --outdir=. --external:obsidian",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/node": "^25.2.3",
		"@types/turndown": "^5.0.6",
		"@us-legal-tools/courtlistener-sdk": "^1.5.2",
		"esbuild": "^0.27.3",
		"turndown": "^7.2.2",
		"typescript": "^5.9.3",
		"yaml": "^2.8.2",
		"vitest": "^5.0.3",
		"jsdom": "^30.1.2"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
